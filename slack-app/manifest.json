{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Top 5",
    "description": "Add tasks and view your weekly Top 5 board right inside Slack.",
    "background_color": "#18181b"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "Top 5",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Add to my Top 5",
        "type": "message",
        "callback_id": "add_to_top5_message",
        "description": "Add this message as a task in the next open slot of your Top 5"
      }
    ],
    "slash_commands": [
      {
        "command": "/top5",
        "description": "Add a task to the next open slot in your Top 5 for today",
        "usage_hint": "[task title]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
